# QA stack configuration — copy this file to `qa/.env` (NOT committed;
# `qa/.env` is gitignored) and fill in the values. See qa/README.md.

# OpenRouter API key for the bifrost gateway. This is the only required
# value; without it the stack refuses to start.
#
# Docker Compose loads `qa/.env` automatically (it interpolates
# ${OPENROUTER_API_KEY} into the bifrost service), and the start scripts
# (qa/scripts/setup/) read the same file, so the key is used as-is.
# Alternatives: export OPENROUTER_API_KEY in the shell for one-off runs,
# or set OPENROUTER_KEY_FILE=/path/to/key to keep the key in a file
# OUTSIDE the repo.
OPENROUTER_API_KEY=

# Optional: publish host ports for the bifrost Web UI, host-side smoke
# tests, and the opencode web UI (adds qa/docker-compose.ports.yml).
# Leave empty for the hermetic default — no host port, nothing can
# collide. BIFROST_PORT picks the exact gateway port (default 8080) when
# QA_HOST_PORT is set; QA_WEB_PORT picks the opencode web UI port
# (default 4097, container 4096 — the serve-web.sh port, see qa/README.md
# section 3.6).
# QA_HOST_PORT=8080
# QA_WEB_PORT=4097
